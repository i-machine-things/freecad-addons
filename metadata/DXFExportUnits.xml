<?xml version="1.0" encoding="UTF-8"?>
<!-- Shown by the Addon Manager before install, never installed: DXFExportUnits must not ship a
     package.xml, because FreeCAD then skips its Init.py (see its README). The build fills in
     version and date from the last commit. -->
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>DXF Export Units</name>
  <description>Scales every DXF export in FreeCAD to a chosen unit and sets the DXF $INSUNITS header to match. The setting is in Preferences, Import-Export, DXF + SCALING. Built against FreeCAD 1.1.3's Draft module.</description>
  <maintainer>Allan Noble</maintainer>
  <license>LGPL-2.1-or-later</license>
  <url type="repository" branch="main">https://github.com/i-machine-things/DXFExportUnits</url>
  <url type="bugtracker">https://github.com/i-machine-things/DXFExportUnits/issues</url>
  <url type="readme">https://github.com/i-machine-things/DXFExportUnits/raw/main/README.md</url>
  <freecadmin>1.1.3</freecadmin>
  <tag>dxf</tag>
  <tag>export</tag>
  <tag>units</tag>
  <content>
    <other>
      <name>DXFExportUnits</name>
    </other>
  </content>
</package>
